<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SQLite Gift Manager"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnGoToAdd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add New Gift"
        android:backgroundTint="#4CAF50"
        android:textColor="@color/white"/>

    <Button
        android:id="@+id/btnSelectAll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="All Gifts"
        android:textColor="@color/white"/>

    <!-- Search by message -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/etSearchMessage"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="Exact message"
            android:textColor="#000000"
            android:textColorHint="#757575"/>
        <Button
            android:id="@+id/btnSearchByMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Search"
            android:textColor="@color/white"/>
    </LinearLayout>

    <!-- Weight range -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/etMinWeight"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="Min"
            android:inputType="number"
            android:textColor="#000000"
            android:textColorHint="#757575"/>
        <EditText
            android:id="@+id/etMaxWeight"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="Max"
            android:inputType="number"
            android:textColor="#000000"
            android:textColorHint="#757575"/>
        <Button
            android:id="@+id/btnSearchByRange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Range"
            android:textColor="@color/white"/>
    </LinearLayout>

    <!-- Delete -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/etDeleteThreshold"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="Delete under (gr)"
            android:textColor="#000000"
            android:textColorHint="#757575"/>
        <Button
            android:id="@+id/btnDeleteUnder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete"
            android:textColor="@color/white"/>
    </LinearLayout>

    <!-- Update -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/etStartingLetter"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="Message start letter"
            android:textColor="#000000"
            android:textColorHint="#757575"/>
        <Button
            android:id="@+id/btnIncrementWeight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+1 Unit"
            android:textColor="@color/white"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Database Results:"
        android:textStyle="italic"
        android:textColor="#000000"
        android:layout_marginTop="10dp"/>

    <ListView
        android:id="@+id/lvGifts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:divider="#EEEEEE"
        android:dividerHeight="1dp"/>

</LinearLayout>