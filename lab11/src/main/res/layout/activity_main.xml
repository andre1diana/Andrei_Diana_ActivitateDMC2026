<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Introduceti valorile pentru grafic:"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etVal1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Valoare 1 (ex: 30)"
            android:inputType="number" />

        <EditText
            android:id="@+id/etVal2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Valoare 2 (ex: 50)"
            android:inputType="number" />

        <EditText
            android:id="@+id/etVal3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Valoare 3 (ex: 20)"
            android:inputType="number" />

        <Button
            android:id="@+id/btnShowChart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Afiseaza Grafic BarChart" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>